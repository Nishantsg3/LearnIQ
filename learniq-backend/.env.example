# LearnIQ Backend Environment Configuration Example
# Copy to .env or set in your deployment environment

# Server Port (default: 8080)
PORT=8080

# Spring Active Profile: 'dev' (uses embedded/file H2 DB) or 'prod' (PostgreSQL)
SPRING_PROFILES_ACTIVE=dev

# Application Frontend URL (for CORS and email redirect links)
APP_FRONTEND_URL=http://localhost:5173

# JWT Secret Key (HMAC-SHA256, minimum 32 characters; supply secure random value in production)
APP_JWT_SECRET=your_jwt_secret_key_minimum_32_characters_long_example

# Auto-verify email upon registration (default: true for rapid testing/evaluation)
APP_AUTH_AUTO_VERIFY=true

# Initial Admin Seeding (created on startup if no admin exists)
APP_SEED_ADMIN_EMAIL=admin@learniq.com
APP_SEED_ADMIN_PASSWORD=your_secure_admin_password
APP_SEED_ADMIN_NAME=Admin

# Production PostgreSQL Database (Required when SPRING_PROFILES_ACTIVE=prod)
SPRING_DATASOURCE_URL=jdbc:postgresql://your-db-host:5432/your_db_name
SPRING_DATASOURCE_USERNAME=your_db_user
SPRING_DATASOURCE_PASSWORD=your_db_password

# SMTP Email Configuration (Optional - for scorecard email delivery via SMTP)
MAIL_USERNAME=your_smtp_username
MAIL_PASSWORD=your_smtp_password
MAIL_FROM=learniq.main@gmail.com
