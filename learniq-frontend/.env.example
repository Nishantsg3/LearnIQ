# LearnIQ Frontend Environment Configuration Example
# Copy to .env.development.local for local development overrides

# Backend API Base URL
# For local development with Spring Boot running on port 8080:
VITE_API_URL=http://localhost:8080/api/v1

# For connecting to deployed Render backend:
# VITE_API_URL=https://learniq-backend-vglf.onrender.com/api/v1
